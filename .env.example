# Groq API Key (Free tier Llama 3.1 8B Instant for intent & slot extraction)
# Leave blank to automatically use the offline Hinglish/English regex parser fallback
GROQ_API_KEY=gsk_your_groq_api_key_here

# PostgreSQL & Redis Database Connections
DATABASE_URL=postgresql://voiceuser:voicepass@postgres:5432/voicedb
REDIS_URL=redis://redis:6379/0

# Voice Confidence & Vector Settings
CONFIDENCE_THRESHOLD=0.65
CHROMA_PERSIST_DIR=./chroma_db

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
